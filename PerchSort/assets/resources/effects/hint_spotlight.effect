CCEffect %{
  techniques:
  - passes:
    - vert: spotlight-vs:vert
      frag: spotlight-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        holeA: { value: [0, 0, 0, 0] }
        holeB: { value: [0, 0, 0, 0] }
        shape: { value: [56, 22, 0.58, 1] }
}%

CCProgram spotlight-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * position;
  }
}%

CCProgram spotlight-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec2 uv0;
  in vec4 color;
  uniform Spotlight {
    vec4 holeA;
    vec4 holeB;
    vec4 shape;
  };
  float holeDistance (vec2 p, vec4 rect) {
    if (rect.z <= 0.0) return 1000000.0;
    vec2 halfSize = rect.zw * 0.5;
    vec2 q = abs(p - (rect.xy + halfSize)) - (halfSize - vec2(shape.x));
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - shape.x;
  }
  vec4 frag () {
    vec2 point = uv0 * vec2(1080.0, 1920.0);
    float distance = min(holeDistance(point, holeA), holeDistance(point, holeB));
    float outside = smoothstep(0.0, shape.y, distance);
    float pulse = 0.65 + 0.35 * sin(cc_time.x * 3.2);
    float ring = exp(-abs(distance - 4.0) / 7.0) * pulse;
    vec3 shade = vec3(0.04, 0.07, 0.10);
    vec3 glow = vec3(1.0, 0.84, 0.36);
    vec3 rgb = mix(shade, glow, clamp(ring * 1.4, 0.0, 1.0));
    float alpha = max(shape.z * outside, ring * 0.85) * shape.w;
    return vec4(rgb, alpha) * color;
  }
}%
