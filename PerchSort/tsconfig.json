{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "./temp/declarations/cc",
      "./temp/declarations/cc.env"
    ]
  },
  "include": [
    "assets/scripts/**/*.ts"
  ]
}
